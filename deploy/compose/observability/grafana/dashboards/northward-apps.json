{
  "title": "NG Gateway - Northward Apps",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": { "from": "now-5m", "to": "now" },
  "tags": ["ng-gateway", "northward"],
  "templating": {
    "list": [
      {
        "name": "app_id",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(ng_gateway_northward_app_connected, app_id)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      },
      {
        "name": "plugin_id",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(ng_gateway_northward_app_connected, plugin_id)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Connected (0/1)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "ng_gateway_northward_app_connected{app_id=~\"$app_id\",plugin_id=~\"$plugin_id\"}", "legendFormat": "{{app_id}}/{{plugin_id}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Reconnect rate (/min)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(ng_gateway_northward_app_reconnect_total{app_id=~\"$app_id\",plugin_id=~\"$plugin_id\"}[5m]) * 60", "legendFormat": "{{app_id}}/{{plugin_id}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Messages rate (by direction/result)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum by (app_id, plugin_id, direction, result) (rate(ng_gateway_northward_messages_total{app_id=~\"$app_id\",plugin_id=~\"$plugin_id\"}[5m]))", "legendFormat": "{{app_id}}/{{plugin_id}}/{{direction}}/{{result}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Latency p95 (seconds) by direction/result",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, app_id, plugin_id, direction, result) (rate(ng_gateway_northward_message_latency_seconds_bucket{app_id=~\"$app_id\",plugin_id=~\"$plugin_id\"}[5m])))", "legendFormat": "{{app_id}}/{{plugin_id}}/{{direction}}/{{result}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 }
    }
  ]
}

