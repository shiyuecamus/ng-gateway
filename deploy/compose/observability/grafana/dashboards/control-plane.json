{
  "title": "NG Gateway - Control Plane",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": { "from": "now-5m", "to": "now" },
  "tags": ["ng-gateway", "control"],
  "templating": {
    "list": [
      {
        "name": "channel_id",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(ng_gateway_control_write_requests_total, channel_id)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      },
      {
        "name": "driver",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(ng_gateway_control_write_requests_total, driver)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Write requests rate (by result)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum by (channel_id, driver, result) (rate(ng_gateway_control_write_requests_total{channel_id=~\"$channel_id\",driver=~\"$driver\"}[5m]))", "legendFormat": "{{channel_id}}/{{driver}}/{{result}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Write queue wait p95 (seconds)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, channel_id, driver) (rate(ng_gateway_control_write_queue_wait_seconds_bucket{channel_id=~\"$channel_id\",driver=~\"$driver\"}[5m])))", "legendFormat": "{{channel_id}}/{{driver}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Write execute p95 (seconds) by result",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, channel_id, driver, result) (rate(ng_gateway_control_write_execute_seconds_bucket{channel_id=~\"$channel_id\",driver=~\"$driver\"}[5m])))", "legendFormat": "{{channel_id}}/{{driver}}/{{result}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 }
    }
  ]
}

