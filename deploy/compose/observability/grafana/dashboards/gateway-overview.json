{
  "title": "NG Gateway - Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["ng-gateway"],
  "panels": [
    {
      "type": "stat",
      "title": "Southward channels",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "ng_gateway_southward_channels_total", "legendFormat": "total" },
        { "expr": "ng_gateway_southward_channels_connected", "legendFormat": "connected" }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 }
    },
    {
      "type": "stat",
      "title": "Northward apps",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "ng_gateway_northward_apps_total", "legendFormat": "total" },
        { "expr": "ng_gateway_northward_apps_active", "legendFormat": "active" }
      ],
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 }
    },
    {
      "type": "stat",
      "title": "Collector active tasks",
      "datasource": "Prometheus",
      "targets": [{ "expr": "ng_gateway_collector_active_tasks", "legendFormat": "active" }],
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "System CPU usage (%)",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "ng_gateway_system_cpu_usage_ratio * 100",
          "legendFormat": "system"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "System memory usage (%)",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "ng_gateway_system_memory_usage_ratio * 100",
          "legendFormat": "system"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Process CPU usage (%)",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        { "expr": "ng_gateway_process_cpu_usage_ratio * 100", "legendFormat": "process" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Process memory RSS (MiB)",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "ng_gateway_process_memory_rss_bytes / 1024 / 1024",
          "legendFormat": "process"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Network rate (KB/s)",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "rate(ng_gateway_network_bytes_sent_total[5m]) / 1024",
          "legendFormat": "sent"
        },
        {
          "expr": "rate(ng_gateway_network_bytes_received_total[5m]) / 1024",
          "legendFormat": "recv"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "System disk usage (%)",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "ng_gateway_system_disk_usage_ratio * 100",
          "legendFormat": "system"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 8 }
    }
  ]
}

