{
  "title": "NG Gateway - Backpressure & Queues",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["ng-gateway", "queues"],
  "templating": {
    "list": [
      {
        "name": "queue",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(ng_gateway_queue_depth, queue)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [{ "expr": "ng_gateway_queue_depth{queue=~\"$queue\"}", "legendFormat": "{{queue}}" }],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Queue saturation ratio",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "ng_gateway_queue_depth{queue=~\"$queue\"} / clamp_min(ng_gateway_queue_capacity{queue=~\"$queue\"}, 1)",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Dropped rate (per reason)",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "sum by (queue, reason) (rate(ng_gateway_queue_dropped_total{queue=~\"$queue\"}[5m]))",
          "legendFormat": "{{queue}}/{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Blocked time p95 (seconds)",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(ng_gateway_queue_blocked_seconds_bucket{queue=~\"$queue\"}[5m])))",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 }
    }
  ]
}

