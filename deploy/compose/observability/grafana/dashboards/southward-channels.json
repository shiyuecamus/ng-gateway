{
  "title": "NG Gateway - Southward Channels",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": { "from": "now-5m", "to": "now" },
  "tags": ["ng-gateway", "southward"],
  "templating": {
    "list": [
      {
        "name": "channel_id",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(ng_gateway_southward_channel_connected, channel_id)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      },
      {
        "name": "driver",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(ng_gateway_southward_channel_connected, driver)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Southward channels",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "ng_gateway_southward_channels_total",
          "legendFormat": "total"
        },
        {
          "expr": "ng_gateway_southward_channels_connected",
          "legendFormat": "connected"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 }
    },
    {
      "type": "stat",
      "title": "Devices total",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "ng_gateway_southward_devices_total",
          "legendFormat": "total"
        }
      ],
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 }
    },
    {
      "type": "stat",
      "title": "Data points total",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "ng_gateway_southward_data_points_total",
          "legendFormat": "total"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 6 }
    },
    {
      "type": "stat",
      "title": "Reconnect rate (/min) total",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ng_gateway_southward_channel_reconnect_total[5m])) * 60",
          "legendFormat": "reconnect/min"
        }
      ],
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Connected (0/1)",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "ng_gateway_southward_channel_connected{channel_id=~\"$channel_id\",driver=~\"$driver\"}",
          "legendFormat": "{{channel_id}}/{{driver}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "State (numeric)",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "ng_gateway_southward_channel_state{channel_id=~\"$channel_id\",driver=~\"$driver\"}",
          "legendFormat": "{{channel_id}}/{{driver}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Reconnect rate (/min)",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "rate(ng_gateway_southward_channel_reconnect_total{channel_id=~\"$channel_id\",driver=~\"$driver\"}[5m]) * 60",
          "legendFormat": "{{channel_id}}/{{driver}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Collect cycle p95 (seconds) by result",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, channel_id, driver, result) (rate(ng_gateway_southward_collect_cycle_seconds_bucket{channel_id=~\"$channel_id\",driver=~\"$driver\"}[5m])))",
          "legendFormat": "{{channel_id}}/{{driver}}/{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Point read rate (points/s) by result",
      "datasource": "Prometheus",
      "interval": "1s",
      "targets": [
        {
          "expr": "sum by (channel_id, driver, result) (rate(ng_gateway_southward_point_read_total{channel_id=~\"$channel_id\",driver=~\"$driver\"}[5m]))",
          "legendFormat": "{{channel_id}}/{{driver}}/{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 8 }
    }
  ]
}

