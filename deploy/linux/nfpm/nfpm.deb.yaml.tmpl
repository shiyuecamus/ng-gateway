name: ng-gateway
arch: {{DEB_ARCH}}
platform: linux
version: {{PKG_VERSION}}
section: default
priority: optional
maintainer: "NG Gateway CI <ci@users.noreply.github.com>"
description: "High-throughput IoT gateway (NG Gateway)"
homepage: "https://github.com/shiyuecamus/ng-gateway"
license: "Apache-2.0"

# Runtime dependencies.
depends:
  - ca-certificates
recommends:
  - hostapd
  - dnsmasq-base
  - iw
  - iptables

contents:
  # Install binary + default config.
  - src: {{ROOTFS_DIR}}/opt/ng-gateway/bin/ng-gateway-bin
    dst: /opt/ng-gateway/bin/ng-gateway-bin
  - src: {{ROOTFS_DIR}}/opt/ng-gateway/gateway.toml
    dst: /opt/ng-gateway/gateway.toml

  # Builtin drivers/plugins (may include a `.keep` placeholder).
  - src: {{ROOTFS_DIR}}/opt/ng-gateway/drivers/builtin/*
    dst: /opt/ng-gateway/drivers/builtin/
  - src: {{ROOTFS_DIR}}/opt/ng-gateway/plugins/builtin/*
    dst: /opt/ng-gateway/plugins/builtin/

  - src: {{SYSTEMD_UNIT}}
    dst: /lib/systemd/system/ng-gateway.service

  # AP hotspot resources (init-network.sh deploys units to /lib/systemd/system at first boot).
  - src: {{ROOTFS_DIR}}/opt/ng-gateway/systemd/*
    dst: /opt/ng-gateway/systemd/
  - src: {{ROOTFS_DIR}}/opt/ng-gateway/scripts/*
    dst: /opt/ng-gateway/scripts/

  # Empty directories created by postinstall.sh (not by nfpm).
  # We do NOT use `type: dir` here — that would make dpkg claim ownership of
  # parent directories like /opt and /etc, causing "not empty" warnings on purge.
  # postinstall.sh handles mkdir for /etc/ng-gateway and /var/lib/ng-gateway.

scripts:
  postinstall: {{POSTINSTALL}}
  preremove: {{PREREMOVE}}

