# ng-gateway hostapd service
# Runs hostapd to broadcast the AP hotspot.
# Automatically restarts on failure — AP stays up even if ng-gateway process is not running.
#
# Configuration: /etc/ng-gateway/hostapd.conf (auto-generated by ng-gateway).

[Unit]
Description=NG-Gateway AP Hotspot (hostapd)
After=ng-gateway-ap-setup.service
Requires=ng-gateway-ap-setup.service
# Stop restarting after 5 failures within 30 seconds to prevent infinite
# crash loops (e.g. DFS/RADAR channel rejection). Without this, a config
# error leaves the WiFi interface stuck in __ap mode indefinitely.
StartLimitBurst=5
StartLimitIntervalSec=30

[Service]
Type=simple
ExecStart=/usr/sbin/hostapd /etc/ng-gateway/hostapd.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
