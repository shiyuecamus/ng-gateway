# ng-gateway AP auto-provision (boot-time network probe)
#
# Runs once on every boot for EXCLUSIVE-mode hardware. Checks whether the
# system has a usable management channel (active WiFi connection). If no WiFi
# is connected, takes over the wireless interface from NetworkManager and
# starts the AP hotspot so that a field technician can reach the Web UI
# via the AP to configure the device.
#
# The script exits immediately if the device is not in exclusive mode or if a
# WiFi connection is already established.
#
# Configuration: /etc/ng-gateway/ap-env (auto-generated by init-network.sh)

[Unit]
Description=NG-Gateway AP Auto-Provision (boot-time network probe)
After=NetworkManager.service
Before=ng-gateway.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/ng-gateway/ap-env
ExecStart=/opt/ng-gateway/scripts/ap-auto-provision.sh
ExecStop=/opt/ng-gateway/scripts/ap-teardown.sh

[Install]
WantedBy=multi-user.target
