# ng-gateway AP setup (oneshot)
# Creates the virtual AP interface (concurrent mode) or prepares the primary
# interface (exclusive mode), assigns IP, and configures iptables NAT.
# Runs once at boot before hostapd/dnsmasq start.
#
# Configuration is read from /etc/ng-gateway/ap-env (auto-generated by ng-gateway).
# All interface names are parameterized — no hardcoded wlan0.

[Unit]
Description=NG-Gateway AP Interface Setup
Before=ng-gateway-hostapd.service ng-gateway-dnsmasq.service
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/ng-gateway/ap-env

# Create virtual AP interface in concurrent mode; skip in exclusive mode.
# In concurrent mode, derive a unique MAC to avoid conflicts with the STA interface.
ExecStart=/bin/sh -c '\
  if [ "${AP_EXCLUSIVE}" != "true" ]; then \
    iw dev ${STA_IFACE} interface add ${AP_IFACE} type __ap 2>/dev/null || true; \
    BASE_MAC=$(cat /sys/class/net/${STA_IFACE}/address 2>/dev/null || echo "02:00:00:00:00:00"); \
    OCTET1=$(echo "$BASE_MAC" | cut -d: -f1); \
    DERIVED_MAC=$(printf "%02x" $(( 0x${OCTET1} | 0x02 )) ):$(echo "$BASE_MAC" | cut -d: -f2-5):$(printf "%02x" $(( $(echo "$BASE_MAC" | cut -d: -f6 | xargs printf "0x%s") ^ 0x01 )) ); \
    ip link set ${AP_IFACE} address ${DERIVED_MAC} 2>/dev/null || true; \
  fi; \
  ip link set ${AP_IFACE} up; \
  ip addr flush dev ${AP_IFACE}; \
  ip addr add ${AP_IP}/${AP_PREFIX} dev ${AP_IFACE}'

# Enable IP forwarding + masquerade for AP clients.
# Detect uplink dynamically via default route, fallback to UPLINK_IFACE from ap-env.
ExecStart=/bin/sh -c '\
  UPLINK=$(ip route show default 2>/dev/null | awk "{print \$5; exit}"); \
  [ -z "$UPLINK" ] && UPLINK="${UPLINK_IFACE}"; \
  sysctl -w net.ipv4.ip_forward=1 > /dev/null; \
  iptables -t nat -C POSTROUTING -o $UPLINK -j MASQUERADE 2>/dev/null || \
  iptables -t nat -A POSTROUTING -o $UPLINK -j MASQUERADE; \
  iptables -C FORWARD -i ${AP_IFACE} -o $UPLINK -j ACCEPT 2>/dev/null || \
  iptables -A FORWARD -i ${AP_IFACE} -o $UPLINK -j ACCEPT; \
  iptables -C FORWARD -i $UPLINK -o ${AP_IFACE} -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
  iptables -A FORWARD -i $UPLINK -o ${AP_IFACE} -m state --state RELATED,ESTABLISHED -j ACCEPT'

# Teardown: remove NAT rules and virtual interface.
ExecStop=/bin/sh -c '\
  UPLINK=$(ip route show default 2>/dev/null | awk "{print \$5; exit}"); \
  [ -z "$UPLINK" ] && UPLINK="${UPLINK_IFACE}"; \
  iptables -t nat -D POSTROUTING -o $UPLINK -j MASQUERADE 2>/dev/null || true; \
  iptables -D FORWARD -i ${AP_IFACE} -o $UPLINK -j ACCEPT 2>/dev/null || true; \
  iptables -D FORWARD -i $UPLINK -o ${AP_IFACE} -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true; \
  ip link set ${AP_IFACE} down 2>/dev/null || true; \
  if [ "${AP_EXCLUSIVE}" != "true" ]; then \
    iw dev ${AP_IFACE} del 2>/dev/null || true; \
  fi'

[Install]
WantedBy=multi-user.target
