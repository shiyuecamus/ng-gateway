# ng-gateway AP setup (oneshot)
# Creates the virtual AP interface, assigns IP, and configures iptables NAT.
# Runs once at boot before hostapd/dnsmasq start.
#
# Configuration is read from /etc/ng-gateway/ap-env (auto-generated by ng-gateway).

[Unit]
Description=NG-Gateway AP Interface Setup
Before=ng-gateway-hostapd.service ng-gateway-dnsmasq.service
After=network-pre.target sys-subsystem-net-devices-wlan0.device

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/ng-gateway/ap-env

# Create virtual AP interface (if the primary supports concurrent STA+AP).
# If it already exists, iw will fail silently — that's fine.
ExecStart=/bin/sh -c '\
  iw dev wlan0 interface add ${AP_IFACE} type __ap 2>/dev/null || true; \
  ip link set ${AP_IFACE} up; \
  ip addr flush dev ${AP_IFACE}; \
  ip addr add ${AP_IP}/${AP_PREFIX} dev ${AP_IFACE}'

# Enable IP forwarding + masquerade for AP clients to reach the internet via STA.
ExecStart=/bin/sh -c '\
  sysctl -w net.ipv4.ip_forward=1 > /dev/null; \
  iptables -t nat -C POSTROUTING -o wlan0 -j MASQUERADE 2>/dev/null || \
  iptables -t nat -A POSTROUTING -o wlan0 -j MASQUERADE; \
  iptables -C FORWARD -i ${AP_IFACE} -o wlan0 -j ACCEPT 2>/dev/null || \
  iptables -A FORWARD -i ${AP_IFACE} -o wlan0 -j ACCEPT; \
  iptables -C FORWARD -i wlan0 -o ${AP_IFACE} -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
  iptables -A FORWARD -i wlan0 -o ${AP_IFACE} -m state --state RELATED,ESTABLISHED -j ACCEPT'

# Teardown: remove virtual interface + NAT rules.
ExecStop=/bin/sh -c '\
  iptables -t nat -D POSTROUTING -o wlan0 -j MASQUERADE 2>/dev/null || true; \
  iptables -D FORWARD -i ${AP_IFACE} -o wlan0 -j ACCEPT 2>/dev/null || true; \
  iptables -D FORWARD -i wlan0 -o ${AP_IFACE} -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true; \
  ip link set ${AP_IFACE} down 2>/dev/null || true; \
  iw dev ${AP_IFACE} del 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
