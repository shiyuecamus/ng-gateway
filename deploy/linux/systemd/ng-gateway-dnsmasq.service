# ng-gateway dnsmasq service (AP clients only)
# Provides DHCP + DNS for devices connected to the AP hotspot.
# Automatically restarts on failure.
#
# Configuration: /etc/ng-gateway/dnsmasq-ap.conf (auto-generated by ng-gateway).

[Unit]
Description=NG-Gateway AP DHCP/DNS (dnsmasq)
After=ng-gateway-ap-setup.service
Requires=ng-gateway-ap-setup.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --no-daemon --conf-file=/etc/ng-gateway/dnsmasq-ap.conf
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
