# General
# Runtime root directory for all relative paths.
NG__GENERAL__RUNTIME_DIR="."
# ca cert path
NG__GENERAL__CA_CERT_PATH="ca.crt"
# ca key path
NG__GENERAL__CA_KEY_PATH="ca.key"

# Southward communication configuration
# API synchronous start wait timeout for driver connection (milliseconds)
NG__GENERAL__SOUTHWARD__START_TIMEOUT_MS=2000

# Southward device snapshot TTL GC (point-level).
#
# This controls how long a point baseline (for ReportType::Change detection) can stay in memory
# without being refreshed by a value change. Expired points will be evicted by a background GC task.

# Point baseline TTL in milliseconds. 0 disables eviction.
NG__GENERAL__SOUTHWARD__DEVICE_CHANGE_CACHE_TTL_MS=600000
# Snapshot GC scan interval in milliseconds.
NG__GENERAL__SOUTHWARD__SNAPSHOT_GC_INTERVAL_MS=60000
# Number of async snapshot GC workers.
NG__GENERAL__SOUTHWARD__SNAPSHOT_GC_WORKERS=2
# Max devices to scan per snapshot GC tick (bounds CPU usage).
NG__GENERAL__SOUTHWARD__MAX_DEVICES_PER_SNAPSHOT_TICK=256

# Northward communication configuration
# Internal bounded queue capacity for northward manager
NG__GENERAL__NORTHWARD__QUEUE_CAPACITY=10000
# API synchronous start wait timeout for northward app (milliseconds)
NG__GENERAL__NORTHWARD__START_TIMEOUT_MS=2000

# Collector configuration
# Collection timeout for each device (in milliseconds)
NG__GENERAL__COLLECTOR__COLLECTION_TIMEOUT_MS=30000
# Maximum concurrent collections per channel
NG__GENERAL__COLLECTOR__MAX_CONCURRENT_COLLECTIONS=200
# Outbound queue capacity from collector to gateway (bounded channel)
NG__GENERAL__COLLECTOR__OUTBOUND_QUEUE_CAPACITY=10000
# Retry policy for failed collections (unified with SDK retry semantics)
# Maximum number of retries after a failure (0 = no retries)
NG__GENERAL__COLLECTOR__RETRY_POLICY__MAX_ATTEMPTS=3
# Initial retry interval in milliseconds
NG__GENERAL__COLLECTOR__RETRY_POLICY__INITIAL_INTERVAL_MS=1000
# Maximum retry interval cap in milliseconds
NG__GENERAL__COLLECTOR__RETRY_POLICY__MAX_INTERVAL_MS=30000
# Randomization factor in range [0.0, 1.0] (e.g. 0.2 means ±20% jitter)
NG__GENERAL__COLLECTOR__RETRY_POLICY__RANDOMIZATION_FACTOR=0.2
# Multiplicative factor for each retry step (>= 1.0)
NG__GENERAL__COLLECTOR__RETRY_POLICY__MULTIPLIER=2.0
# Maximum elapsed time for all retries in milliseconds
NG__GENERAL__COLLECTOR__RETRY_POLICY__MAX_ELAPSED_TIME_MS=5000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
#
# Runtime log control (TTL overrides)
NG__LOGGING__CONTROL__OVERRIDE_DEFAULT_TTL_MS=300000
NG__LOGGING__CONTROL__OVERRIDE_MIN_TTL_MS=10000
NG__LOGGING__CONTROL__OVERRIDE_MAX_TTL_MS=1800000
NG__LOGGING__CONTROL__OVERRIDE_CLEANUP_INTERVAL_MS=5000
NG__LOGGING__CONTROL__INGEST_QUEUE_CAPACITY=10000

# Logging output pipeline
NG__LOGGING__OUTPUT__FORMAT="text"                 # text | json
NG__LOGGING__OUTPUT__INCLUDE_SPAN_FIELDS=true
NG__LOGGING__OUTPUT__FILE__ENABLED=true
NG__LOGGING__OUTPUT__FILE__DIR="./logs"
NG__LOGGING__OUTPUT__FILE__ROTATION__MODE="both"   # time | size | both
NG__LOGGING__OUTPUT__FILE__ROTATION__TIME="daily"  # hourly | daily
NG__LOGGING__OUTPUT__FILE__ROTATION__SIZE_MB=100
NG__LOGGING__OUTPUT__FILE__ROTATION__MAX_FILES=200
NG__LOGGING__OUTPUT__FILE__RETENTION__MAX_DAYS=7
NG__LOGGING__OUTPUT__FILE__RETENTION__MAX_TOTAL_SIZE_MB=2048

# Log cleanup worker (deletes old rotated files by policy)
NG__LOGGING__CLEANUP__ENABLED=true
NG__LOGGING__CLEANUP__INTERVAL_MS=60000

# Web
# router prefix
NG__WEB__ROUTER_PREFIX="/api"
# host
NG__WEB__HOST="0.0.0.0"
# port
NG__WEB__PORT=5678
# gt 0 use exact number
# 0 use CPU count
# lt 0 use CPU count / abs(workers)
NG__WEB__WORKERS=0

# Web UI (single-container, served by the gateway process)
# Enable/disable UI serving.
NG__WEB__UI__ENABLED=true
# Mode: embedded_zip | filesystem | disabled
# - filesystem: serve from local directory (developer mode / Docker all-in-one)
# - embedded_zip: serve from `ng-gateway-web/ui-dist.zip` compiled into the binary (Homebrew single-binary)
NG__WEB__UI__MODE="filesystem"
# Filesystem root directory containing `index.html` and assets (Vite dist output).
NG__WEB__UI__FILESYSTEM_ROOT="/app/ui"

# Web SSL
# enabled
NG__WEB__SSL__ENABLED=true
# port
NG__WEB__SSL__PORT=8443
# type
# auto: generate or load from ca_cert_path and ca_key_path
# local: load from cert and key
NG__WEB__SSL__TYPE="auto"
# cert path
NG__WEB__SSL__CERT="./certs/cert.pem"
# key path
NG__WEB__SSL__KEY="./certs/key.pem"

# Web CORS
# Cros mode
# allow_all, whitelist
NG__WEB__CORS__MODE="allow_all"

# Web CORS Whitelist
NG__WEB__CORS__WHITELIST__ORIGINS="*"
NG__WEB__CORS__WHITELIST__METHODS="GET,POST,PUT,DELETE"
NG__WEB__CORS__WHITELIST__HEADERS="Content-Type,AccessToken,X-CSRF-Token,Authorization,Token,X-Token,X-User-Id"
NG__WEB__CORS__WHITELIST__EXPOSE_HEADERS="Content-Length,Access-Control-Allow-Origin,Access-Control-Allow-Headers,Content-Type"
NG__WEB__CORS__WHITELIST__CREDENTIALS=true

# JWT
# secret
NG__WEB__JWT__SECRET="ng-gateway"
# expire
NG__WEB__JWT__EXPIRE=3600000
# issuer
NG__WEB__JWT__ISSUER="ng-gateway"

# Cache
# type
# only moka is supported
NG__CACHE__TYPE="moka"
# prefix
NG__CACHE__PREFIX="ng-gateway"
# delimiter
NG__CACHE__DELIMITER=":"

# Database
# SQLite database file path (will be created automatically if not exists)
# Final path resolves under ./data
NG__DB__SQLITE__PATH="ng-gateway.db"
# Connection timeout in milliseconds
NG__DB__SQLITE__TIMEOUT=5000
# Idle timeout in milliseconds
NG__DB__SQLITE__IDLE_TIMEOUT=5000
# Maximum connection lifetime in milliseconds
NG__DB__SQLITE__MAX_LIFETIME=5000
# Maximum number of connections
NG__DB__SQLITE__MAX_CONNECTIONS=100
# Auto create database file and directory if not exists
NG__DB__SQLITE__AUTO_CREATE=true
